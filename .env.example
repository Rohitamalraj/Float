# ─────────────────────────────────────────────────────────────────────────────
# Float — environment template. Copy to `.env` and fill in.
# Every service reads from this file (loaded via @float/config). Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# Active chain for every service: sepolia | mainnet | anvil
FLOAT_CHAIN=sepolia

# ── RPC / explorer ───────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
ANVIL_RPC_URL=http://127.0.0.1:8545
ETHERSCAN_API_KEY=

# ── Datastores ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://float:float@localhost:5432/float
REDIS_URL=redis://localhost:6379

# ── Keys (hex, 0x-prefixed). Use test-only keys on Sepolia/anvil. ────────────
# Deploys the Float venue contracts and acts as their admin.
DEPLOYER_PRIVATE_KEY=
# Holds COMPLIANCE_ORACLE_ROLE — writes attestations to the registry + ENS.
COMPLIANCE_ORACLE_PRIVATE_KEY=
# Provisions ENS subnames + resolvers for onboarded businesses (owns `float.eth`).
ENS_PROVISIONER_PRIVATE_KEY=
# Holds POLICY_SYNC_ROLE on FloatPolicyView — mirrors ENS policy on-chain.
POLICY_SYNC_PRIVATE_KEY=
# The agent session signer held by the agent-service (scoped by Layer 1 policy).
AGENT_SESSION_SIGNER_PRIVATE_KEY=

# ── Float protocol roles / addresses ─────────────────────────────────────────
FLOAT_ADMIN_ADDRESS=
FLOAT_TREASURY_ADDRESS=

# ── Float-deployed contract addresses (fill after `DeployFloatVenue.s.sol`) ──
FLOAT_COMPLIANCE_REGISTRY_ADDRESS=
FLOAT_ALLOWLIST_CHECKER_ADDRESS=
FLOAT_SWEEP_EXECUTOR_ADDRESS=
FLOAT_POLICY_VIEW_ADDRESS=
FLOAT_USTB_ADDRESS=
FLOAT_YIELD_RESERVE_ADDRESS=
FLOAT_PERMISSIONS_ADAPTER_ADDRESS=
FLOAT_POOL_ID=

# Stablecoin leg (Sepolia test USDC). Override per chain.
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ── ENS v2 ───────────────────────────────────────────────────────────────────
# Parent name Float issues business subnames under.
ENS_PARENT_NAME=float.eth
# Optional overrides for ENS v2 contract addresses (else taken from @float/config).
ENS_REGISTRY_ADDRESS=
ENS_PERMISSIONED_RESOLVER_IMPL_ADDRESS=

# ── ERC-4337 / ZeroDev ───────────────────────────────────────────────────────
ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=
ZERODEV_PAYMASTER_RPC=
# Kernel account version: 0.3.1 | 0.3.2 | 0.3.3
KERNEL_VERSION=0.3.3
# EntryPoint 0.7 — override only if using a non-canonical deployment.
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# ── Bazantic x402 gateway ────────────────────────────────────────────────────
GATEWAY_PORT=8402
X402_ENABLED=true
# enforce = reject unpaid calls; permissive = log + allow (dev / behind a hosted gateway)
X402_MODE=enforce
X402_NETWORK=base-sepolia
# Address that receives x402 micro-payments for /v1/check calls.
X402_RECEIVING_ADDRESS=
X402_PRICE_USDC=0.01
# Facilitator that verifies + settles x402 payments (Bazantic-hosted or self).
X402_FACILITATOR_URL=https://x402.org/facilitator
# Per-caller-IP request budget for the gateway's free route (/v1/policy) and
# pre-payment /v1/check challenges. Single-process, in-memory (see docs/runbook.md).
GATEWAY_RATE_LIMIT_PER_MINUTE=60

# ── Web (dashboard + admin) ──────────────────────────────────────────────────
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-me-32-bytes-min-000000000000
SIWE_DOMAIN=localhost:3000
# Comma-separated addresses (or emails) allowed into the Float admin console.
ADMIN_ALLOWLIST=

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CHAIN=sepolia

# ── Notifications ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Float <noreply@float.example>

# ── Agent service ───────────────────────────────────────────────────────────
AGENT_SERVICE_PORT=8080
# How far ahead (hours) to sweep out for an upcoming obligation.
SWEEP_OUT_LOOKAHEAD_HOURS=48
# Poll fallback interval (ms) when websockets are unavailable.
WATCHER_POLL_INTERVAL_MS=15000
# Full re-evaluation cadence (ms) — safety net for missed Transfer events.
EVALUATE_INTERVAL_MS=300000
# Slippage bound on sweep quotes, basis points.
SWEEP_SLIPPAGE_BPS=50
# Skip sweeps below this size, USDC.
MIN_SWEEP_USDC=25
# Refuse to trade on a compliance attestation older than this (hours).
MAX_COMPLIANCE_AGE_HOURS=720
# Parallel sweep executions.
EXECUTE_CONCURRENCY=4

# ── Web client (NEXT_PUBLIC_* are exposed to the browser) ────────────────────
NEXT_PUBLIC_ENS_PARENT=float.eth
