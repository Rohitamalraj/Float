{
  "name": "@float/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@float/config": "workspace:*",
    "@float/contracts-sdk": "workspace:*",
    "@float/core": "workspace:*",
    "@float/db": "workspace:*",
    "@float/ens": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.0",
    "pino": "^10.3.1",
    "viem": "^2.37.6",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1"
  }
}
