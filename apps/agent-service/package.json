{
  "name": "@float/agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "attack:out-of-policy": "node dist/scripts/out-of-policy-attack.js",
    "harness": "node dist/scripts/integration-harness.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@float/config": "workspace:*",
    "@float/contracts-sdk": "workspace:*",
    "@float/core": "workspace:*",
    "@float/db": "workspace:*",
    "@float/ens": "workspace:*",
    "@float/uniswap": "workspace:*",
    "@float/wallet": "workspace:*",
    "bullmq": "^5.81.0",
    "ioredis": "^5.11.0",
    "pino": "^10.3.1",
    "viem": "^2.37.6",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1"
  }
}
